# Copiar como .env.production antes de compilar para producción.
# Las variables VITE_* son públicas: nunca colocar contraseñas ni secretos.
# Requiere configurar Nginx para enrutar autenticación y gestión.
VITE_USE_API=true
VITE_API_BASE_URL=https://recaudacion.aosc-enteregulador.gob.ar/api/v1
VITE_AUTH_BASE_URL=https://recaudacion.aosc-enteregulador.gob.ar
# Identificador público del mismo cliente OAuth usado por auth-service.
VITE_GOOGLE_CLIENT_ID=REEMPLAZAR_GOOGLE_CLIENT_ID
