# Plantilla de producción. Copiar como auth-service.env FUERA del repositorio.
# Reemplazar todos los marcadores antes de iniciar el servicio.
# systemd debe cargar el archivo mediante EnvironmentFile.
SPRING_PROFILES_ACTIVE=prod
AUTH_SERVICE_PORT=8080
SERVER_ADDRESS=127.0.0.1

AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=REEMPLAZAR_USUARIO_AUTH
AUTH_DB_PASSWORD=REEMPLAZAR_PASSWORD_AUTH

# Estos tres valores deben coincidir con morosos-service.env.
# Generar JWT_SECRET aleatorio, de al menos 32 bytes.
JWT_SECRET=REEMPLAZAR_SECRETO_ALEATORIO_COMPARTIDO
JWT_ISSUER=https://recaudacion.aosc-enteregulador.gob.ar
JWT_AUDIENCE=gestion-aosc

FRONTEND_URL=https://recaudacion.aosc-enteregulador.gob.ar
FRONTEND_RESET_PASSWORD_URL=https://recaudacion.aosc-enteregulador.gob.ar/restablecer-contrasena

# PRIMER ARRANQUE: completar la contraseña y cambiar enabled a true.
# Tras verificar el acceso, volver a false y retirar la contraseña del archivo.
AUTH_SEED_ADMIN_ENABLED=false
AUTH_SEED_ADMIN_USERNAME=admin
AUTH_SEED_ADMIN_EMAIL=lucianogatti01@gmail.com
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_ADMIN_NOMBRE=Luciano
AUTH_SEED_ADMIN_APELLIDO=Gatti

# Google habilitado. Completar credenciales reales antes de iniciar.
# El Client ID debe coincidir con VITE_GOOGLE_CLIENT_ID del frontend.
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=REEMPLAZAR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REEMPLAZAR_GOOGLE_CLIENT_SECRET

# Correo opcional, pendiente de configurar.
AUTH_MAIL_ENABLED=false
AUTH_MAIL_HOST=
AUTH_MAIL_PORT=587
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_MAIL_FROM=
AUTH_MAIL_FROM_NAME="Sistema de Morosidad AOSC"
AUTH_MAIL_SMTP_AUTH=true
AUTH_MAIL_SMTP_STARTTLS=true
