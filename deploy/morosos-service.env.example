# Plantilla de producción. Copiar como morosos-service.env FUERA del repositorio.
# Reemplazar todos los marcadores antes de iniciar el servicio.
# systemd debe cargar el archivo mediante EnvironmentFile.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/morosos_db
SPRING_DATASOURCE_USERNAME=REEMPLAZAR_USUARIO_MOROSOS
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_PASSWORD_MOROSOS

# Deben coincidir exactamente con auth-service.env.
JWT_SECRET=REEMPLAZAR_SECRETO_ALEATORIO_COMPARTIDO
JWT_ISSUER=https://recaudacion.aosc-enteregulador.gob.ar
JWT_AUDIENCE=gestion-aosc

AUTH_SERVICE_BASE_URL=http://127.0.0.1:8080
APP_CORS_ALLOWED_ORIGINS=https://recaudacion.aosc-enteregulador.gob.ar
